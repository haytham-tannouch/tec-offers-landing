---
const testimonials = [
  {
    name: "Hicham R.",
    role: "Entrepreneur",
    location: "Casablanca",
    content: "Un accompagnement sur-mesure et un site web qui inspire confiance à mes clients. Je recommande vivement !",
    image: "/images/Hicham R.webp",
    rating: 5
  },
  {
    name: "Karine M.",
    role: "Medecin généraliste",
    location: "Paris",
    content: "Grâce à leur expertise, notre agence a gagné en visibilité et en crédibilité. Un travail remarquable !",
    image: "/images/Karine M.webp",
    rating: 5
  },
  {
    name: "Sophie T.",
    role: "Responsable marketing",
    location: "Lyon",
    content: "L'équipe a su comprendre nos besoins et livrer un site moderne, rapide et efficace. Nos clients sont ravis !",
    image: "/images/Sophie T.webp",
    rating: 4
  },
  {
    name: "Dr. Mohamad B.",
    role: "Médecin généraliste",
    location: "Rabat",
    content: "Le site est intuitif et professionnel, il facilite la prise de rendez-vous pour mes patients.",
    image: "/images/docteur.webp",
    rating: 5
  }
];
---

<section class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold text-center mb-12">Ce que nos clients disent</h2>
    <div class="relative">
      <div class="overflow-hidden">
        <div class="flex transition-transform duration-500 ease-in-out" id="testimonial-slider">
          {testimonials.map((testimonial) => (
            <div class="w-full flex-shrink-0 px-4">
              <div class="bg-gray-50 rounded-xl p-8 shadow-lg">
                <div class="flex items-center mb-6">
                  <img
                    src={testimonial.image}
                    alt={testimonial.name}
                    class="w-16 h-16 rounded-full object-cover"
                    loading="lazy"
                    width="64"
                    height="64"
                  />
                  <div class="ml-4">
                    <h3 class="font-bold text-lg flex items-center gap-2">
                      {testimonial.name}
                      <span class="flex items-center">
                        {Array.from({ length: 5 }).map((_, i) => (
                          <svg
                            class={`w-4 h-4 ${i < testimonial.rating ? 'text-yellow-400' : 'text-gray-300'}`}
                            fill="currentColor"
                            viewBox="0 0 20 20"
                          >
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.967a1 1 0 00.95.69h4.175c.969 0 1.371 1.24.588 1.81l-3.38 2.455a1 1 0 00-.364 1.118l1.287 3.966c.3.922-.755 1.688-1.54 1.118l-3.38-2.454a1 1 0 00-1.175 0l-3.38 2.454c-.784.57-1.838-.196-1.54-1.118l1.287-3.966a1 1 0 00-.364-1.118L2.05 9.394c-.783-.57-.38-1.81.588-1.81h4.175a1 1 0 00.95-.69l1.286-3.967z" />
                          </svg>
                        ))}
                      </span>
                    </h3>
                    <p class="text-gray-600">{testimonial.role}</p>
                    <p class="text-gray-500 text-sm">{testimonial.location}</p>
                  </div>
                </div>
                <p class="text-gray-700 italic">"{testimonial.content}"</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <button
        class="absolute left-0 top-1/2 transform -translate-y-1/2 bg-white rounded-full p-2 shadow-lg hover:bg-gray-100"
        id="prev-btn"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      <button
        class="absolute right-0 top-1/2 transform -translate-y-1/2 bg-white rounded-full p-2 shadow-lg hover:bg-gray-100"
        id="next-btn"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  let currentSlide = 0;
  const slider = document.getElementById('testimonial-slider');
  const slides = slider?.children;
  const totalSlides = slides?.length || 0;

  function updateSlider() {
    if (slider && slides) {
      slider.style.transform = `translateX(-${currentSlide * 100}%)`;
    }
  }

  document.getElementById('prev-btn')?.addEventListener('click', () => {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    updateSlider();
  });

  document.getElementById('next-btn')?.addEventListener('click', () => {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlider();
  });

  // Auto-advance slides every 5 seconds
  setInterval(() => {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlider();
  }, 5000);
</script> 