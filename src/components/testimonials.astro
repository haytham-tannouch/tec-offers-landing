---
const testimonials = [
  {
    name: "Ahmed Benali",
    role: "Restaurateur",
    location: "Casablanca",
    content: "Un site web magnifique qui a transformé notre visibilité en ligne. Les réservations ont augmenté de 40% depuis la mise en ligne !",
    image: "/images/testimonial-1.webp"
  },
  {
    name: "Sophie Martin",
    role: "Directrice Marketing",
    location: "Paris",
    content: "Une équipe professionnelle qui a su comprendre nos besoins et créer un site web parfaitement adapté à notre image de marque.",
    image: "/images/testimonial-2.webp"
  },
  {
    name: "Karim El Fathi",
    role: "Agent Immobilier",
    location: "Rabat",
    content: "Le site web a considérablement amélioré notre présence en ligne. Les clients peuvent maintenant facilement consulter nos biens.",
    image: "/images/testimonial-3.webp"
  },
  {
    name: "Marie Dubois",
    role: "Formatrice",
    location: "Lyon",
    content: "Un site web moderne et intuitif qui nous permet de présenter nos formations de manière professionnelle.",
    image: "/images/testimonial-4.webp"
  },
  {
    name: "Youssef Alami",
    role: "Entrepreneur",
    location: "Marrakech",
    content: "Une expérience client exceptionnelle du début à la fin. Le site web est rapide, beau et parfaitement optimisé.",
    image: "/images/testimonial-5.webp"
  }
];
---

<section class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold text-center mb-12">Ce que nos clients disent</h2>
    <div class="relative">
      <div class="overflow-hidden">
        <div class="flex transition-transform duration-500 ease-in-out" id="testimonial-slider">
          {testimonials.map((testimonial) => (
            <div class="w-full flex-shrink-0 px-4">
              <div class="bg-gray-50 rounded-xl p-8 shadow-lg">
                <div class="flex items-center mb-6">
                  <img
                    src={testimonial.image}
                    alt={testimonial.name}
                    class="w-16 h-16 rounded-full object-cover"
                    loading="lazy"
                    width="64"
                    height="64"
                  />
                  <div class="ml-4">
                    <h3 class="font-bold text-lg">{testimonial.name}</h3>
                    <p class="text-gray-600">{testimonial.role}</p>
                    <p class="text-gray-500 text-sm">{testimonial.location}</p>
                  </div>
                </div>
                <p class="text-gray-700 italic">"{testimonial.content}"</p>
              </div>
            </div>
          ))}
        </div>
      </div>
      <button
        class="absolute left-0 top-1/2 transform -translate-y-1/2 bg-white rounded-full p-2 shadow-lg hover:bg-gray-100"
        id="prev-btn"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      <button
        class="absolute right-0 top-1/2 transform -translate-y-1/2 bg-white rounded-full p-2 shadow-lg hover:bg-gray-100"
        id="next-btn"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  let currentSlide = 0;
  const slider = document.getElementById('testimonial-slider');
  const slides = slider?.children;
  const totalSlides = slides?.length || 0;

  function updateSlider() {
    if (slider && slides) {
      slider.style.transform = `translateX(-${currentSlide * 100}%)`;
    }
  }

  document.getElementById('prev-btn')?.addEventListener('click', () => {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    updateSlider();
  });

  document.getElementById('next-btn')?.addEventListener('click', () => {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlider();
  });

  // Auto-advance slides every 5 seconds
  setInterval(() => {
    currentSlide = (currentSlide + 1) % totalSlides;
    updateSlider();
  }, 5000);
</script> 