---
const features = [
  {
    title: "Site Vitrine 5 Pages",
    description: "Un site web professionnel avec 5 pages optimisées pour présenter votre activité",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
    </svg>`,
    isFree: true
  },
  {
    title: "Design Responsive",
    description: "Un site web qui s'adapte parfaitement à tous les écrans",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
    </svg>`,
    isFree: true
  },
  {
    title: "Optimisation SEO",
    description: "Un site web optimisé pour les moteurs de recherche dès le lancement",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>`,
    isFree: true
  },
  {
    title: "Formation d'Utilisation",
    description: "Une formation complète pour gérer votre site web en toute autonomie",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
    </svg>`,
    isFree: true
  }
];

const maintenanceFeatures = [
  {
    title: "Hébergement Premium",
    description: "Hébergement haute performance sur des serveurs sécurisés avec temps de chargement optimal et protection contre les attaques",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
    </svg>`
  },
  {
    title: "Nom de Domaine Personnalisé",
    description: "Votre nom de domaine professionnel pour une identité en ligne unique et mémorable",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
    </svg>`
  },
  {
    title: "Maintenance Technique",
    description: "Mises à jour régulières, sauvegardes quotidiennes, surveillance 24/7 et corrections immédiates en cas de problème",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
    </svg>`
  },
  {
    title: "Support Prioritaire",
    description: "Assistance technique dédiée et réactive pour toute question ou modification nécessaire",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 01.88-2.5L5 10m2-1V7a2 2 0 012-2h3a2 2 0 012 2v2m1 1h2a2 2 0 012 2v2a2 2 0 01-2 2h-1m-2 0h-1m-1 0H9m-1 0H7a2 2 0 01-2-2v-2a2 2 0 012-2h2"/>
    </svg>`
  }
];
---

<section class="py-20 bg-gradient-to-b from-blue-50 to-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-4">Notre Offre Transparente</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Un site web professionnel clé en main pour propulser votre présence en ligne
      </p>
    </div>

    <div class="mb-20">
      <h3 class="text-2xl font-bold text-center mb-8 text-green-600">
        Création de Votre Site Web
        <span class="block text-lg font-normal text-gray-600 mt-2">
          Nous développons votre site professionnel sans frais de conception
        </span>
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {features.map((feature) => (
          <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
            <div class="text-green-600 mb-4" set:html={feature.icon} />
            <h3 class="text-xl font-bold mb-2">{feature.title}</h3>
            <p class="text-gray-600">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mb-16">
      <h3 class="text-2xl font-bold text-center mb-8 text-blue-600">
        Services Essentiels
        <span class="block text-lg font-normal text-gray-600 mt-2">
          Pour que le site reste en ligne 24h/24, sécurisé, rapide et accessible à vos clients
        </span>
      </h3>
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
        <p class="text-gray-600">
          Pour garantir le bon fonctionnement de votre site, nous assurons un hébergement professionnel et un suivi technique régulier
        </p>
        <div class="bg-blue-50 p-4 rounded-lg">
          <p class="text-blue-800 font-medium">
            Ces services essentiels nécessitent un forfait annuel pour la mise en ligne du site et l'accès à notre support technique
          </p>
          <p class="text-blue-600 text-sm mt-2">
            Le forfait inclut : hébergement premium, nom de domaine, maintenance continue, sauvegardes et assistance
          </p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {maintenanceFeatures.map((feature) => (
          <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow border-t-4 border-blue-600">
            <div class="text-blue-600 mb-4" set:html={feature.icon} />
            <h3 class="text-xl font-bold mb-2">{feature.title}</h3>
            <p class="text-gray-600">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 text-center">
      <div class="bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl p-8 max-w-4xl mx-auto">
        <h3 class="text-3xl font-bold mb-6">Une Offre Simple et Transparente</h3>
        <div class="text-lg mb-8 space-y-4">
          <p class="bg-blue-500/30 p-4 rounded-lg">
            <span class="font-bold text-yellow-400">✨ CRÉATION</span> : Développement professionnel de votre site web sans frais initiaux
          </p>
          <p class="bg-blue-500/30 p-4 rounded-lg">
            <span class="font-bold text-yellow-400">🛡️ SERVICES ESSENTIELS</span> : Forfait annuel requis pour l'hébergement, le nom de domaine et la maintenance technique
          </p>
        </div>
        <div class="bg-blue-500/30 p-6 rounded-lg mb-8 max-w-2xl mx-auto">
          <p class="text-lg">
            Pour maintenir votre site en ligne et bénéficier de nos services de maintenance et support, un forfait annuel est nécessaire
          </p>
        </div>
        <a
          href="#checkout"
          class="inline-block bg-yellow-400 text-blue-900 px-8 py-4 rounded-lg font-bold text-lg hover:bg-yellow-300 transition-colors"
        >
          Découvrir le Forfait Annuel
        </a>
        <p class="text-sm mt-4 text-blue-100">Engagement annuel - Paiement mensuel possible</p>
      </div>
    </div>
  </div>
</section> 